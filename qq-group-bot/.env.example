# QQ 开放平台机器人凭证。不要提交或分享真实 AppSecret。
QQ_APP_ID=请填写机器人AppID
QQ_APP_SECRET=请填写机器人AppSecret

# 授权群 group_openid，多个群用英文逗号分隔。
# 留空：发现模式，只显示群 ID，不保存消息。
# *：明确允许机器人所在的所有群，不推荐用于多群场景。
QQ_ALLOWED_GROUPS=

# 本地 SQLite 文件；相对路径以项目目录为基准。
QQ_DATABASE_PATH=data/qq_messages.db

# 消息保留天数；0 表示不自动删除。
QQ_RETENTION_DAYS=30

# DEBUG、INFO、WARNING 或 ERROR。
QQ_LOG_LEVEL=INFO
