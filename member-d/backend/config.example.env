# 示例文件不自动加载。请通过操作系统环境变量配置。
QUNYI_MODE=mock
QUNYI_STATE=state
QUNYI_TIMEOUT=12
QUNYI_DEADLINE=30
QUNYI_MAX_CALLS=3
# 实际接入时设置以下三项，并切换 live；不要写真实密钥到本文件。
# QUNYI_MODEL_URL=https://your-allowed-provider.example/full/chat/completions
# QUNYI_MODEL=your-model-id
# QUNYI_API_KEY=configure-locally
# 可选 QUNYI_TOKENS 为 {"随机且至少16位ASCII令牌":"空间名称"} JSON；默认生成本机凭据。
# QUNYI_ALLOW_HTTP_LOOPBACK=1 仅用于本地合成服务测试，不能用于外部HTTP。
